#: build/block-library.js:1
#: build/editor.js:1
msgid "Controls whether the link opens in the same tab or a new tab."
msgstr ""

#: build/block-library.js:1
#: build/editor.js:1
msgid "Sets relationship attributes for link output, such as `nofollow` or `noopener`."
msgstr ""

#: build/block-library.js:1
#: build/editor.js:1
msgid "Chooses the visual style: primary/default, secondary, outline, ghost, destructive, or link."
msgstr ""

#: build/block-library.js:1
#: build/editor.js:1
msgid "Chooses the button size preset."
msgstr ""

#: build/block-library.js:1
#: build/editor.js:1
