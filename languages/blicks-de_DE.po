#. Plugin Name of the plugin
#: blicks.php
#: src/Providers/AdminServiceProvider.php:16
#: src/Providers/AdminServiceProvider.php:17
msgid "Blicks"
msgstr "Blicks"

#. Description of the plugin
#: blicks.php
msgid "A WordPress plugin."
msgstr "Ein WordPress-Plugin."

#: resources/patterns/01-hero.php:9
msgid "Hero — aurora"
msgstr "Hero — Aurora"

#: resources/patterns/01-hero.php:10
msgid ""
"A dark hero: status chip, gradient headline, supporting copy, and dual CTA."
msgstr "Ein dunkler Hero: Status-Chip, Verlaufsüberschrift, unterstützender Text und doppelter CTA."

#: resources/patterns/02-bento.php:9
msgid "Logo cloud"
msgstr "Logo-Wolke"

#: resources/patterns/02-bento.php:10
msgid ""
"A centered trust strip: eyebrow label and a wrapping row of wordmark logos."
msgstr "Ein zentrierter Vertrauensstreifen: Eyebrow-Label und eine umbrechende Reihe von Wortmarken-Logos."

#: resources/patterns/03-marquee-logos.php:9
msgid "Feature grid"
msgstr "Feature-Raster"

#: resources/patterns/03-marquee-logos.php:10
msgid ""
"A six-tile feature grid with gradient icon tiles, headings, and body copy."
msgstr "Ein sechs Kacheln großes Feature-Raster mit Verlaufs-Symbolkacheln, Überschriften und Fließtext."

#: resources/patterns/04-feature-diagonal.php:9
msgid "Stats band"
msgstr "Statistik-Band"

#: resources/patterns/04-feature-diagonal.php:10
msgid "Four big gradient metrics with labels under a centered heading."
msgstr "Vier große Verlaufsmetriken mit Labels unter einer zentrierten Überschrift."

#: resources/patterns/05-pricing.php:9
msgid "Pricing tiers"
msgstr "Preisstufen"

#: resources/patterns/05-pricing.php:10
msgid ""
"Three pricing cards with a highlighted middle tier, feature lists, and CTAs."
msgstr "Drei Preiskarten mit hervorgehobener Mittelstufe, Feature-Listen und CTAs."

#: resources/patterns/06-stats-rings.php:9
msgid "Testimonials"
msgstr "Testimonials"

#: resources/patterns/06-stats-rings.php:10
msgid "Three quote cards with star ratings and author avatars."
msgstr "Drei Zitatkarten mit Sternebewertungen und Autoren-Avataren."

#: resources/patterns/07-cta.php:9
msgid "CTA — gradient band"
msgstr "CTA — Verlaufsband"

#: resources/patterns/07-cta.php:10
msgid ""
"A glowing gradient call-to-action band with heading, copy, and dual buttons."
msgstr "Ein leuchtendes Verlaufs-Call-to-Action-Band mit Überschrift, Text und doppelten Buttons."

