{
    "name": "blicks",
    "version": "1.0.0",
    "packageManager": "pnpm@10.32.1",
    "scripts": {
        "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
        "gen:icons": "node scripts/gen-icons.mjs",
        "predev": "node scripts/gen-icons.mjs",
        "prebuild": "node scripts/gen-icons.mjs",
        "dev": "run-p dev:js dev:block-library dev:modules",
        "dev:js": "vite build --watch",
        "dev:block-library": "vite build --config vite.block-library.config.mjs --watch",
        "dev:modules": "vite build --config vite.modules.config.mjs --watch",
        "build": "vite build && vite build --config vite.block-library.config.mjs && vite build --config vite.modules.config.mjs",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "lint:css": "stylelint \"resources/**/*.scss\"",
        "test": "vitest run",
        "test:integration": "wp-env run tests-cli --env-cwd=wp-content/plugins/blicks/tests/integration vendor/bin/phpunit",
        "env:start": "wp-env start",
        "env:stop": "wp-env stop",
        "test:watch": "vitest",
        "i18n:pot": "pnpm build && pnpm i18n:pot:from-build",
        "i18n:pot:from-build": "wp i18n make-pot . languages/blicks.pot --slug=blicks --exclude=vendor,node_modules,build,tests && node scripts/append-admin-pot.js",
        "i18n:json": "wp i18n make-json languages --no-purge && node scripts/rename-admin-json.mjs",
        "bundle": "node scripts/bundle.js"
    },
    "devDependencies": {
        "@emotion/react": "^11.14.0",
        "@eslint/js": "^9.39.4",
        "@kucrut/vite-for-wp": "^0.12.0",
        "@types/node": "^24.13.2",
        "@types/prismjs": "^1.26.6",
        "@types/react": "^18.3.31",
        "@types/react-dom": "^18.3.7",
        "@wordpress/api-fetch": "7.48.0",
        "@wordpress/block-editor": "15.21.0",
        "@wordpress/blocks": "15.21.0",
        "@wordpress/components": "35.0.0",
        "@wordpress/compose": "8.1.0",
        "@wordpress/data": "10.48.0",
        "@wordpress/element": "8.0.0",
        "@wordpress/env": "^10.0.0",
        "@wordpress/format-library": "5.48.0",
        "@wordpress/hooks": "4.48.0",
        "@wordpress/i18n": "6.21.0",
        "@wordpress/private-apis": "1.48.0",
        "@wordpress/rich-text": "7.48.0",
        "archiver": "^7.0.0",
        "eslint": "^9.39.4",
        "eslint-plugin-react-hooks": "^7.1.1",
        "jsdom": "^30.0.1",
        "lucide-static": "1.18.0",
        "npm-run-all2": "^9.0.2",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "rollup-plugin-external-globals": "^0.13.0",
        "sass": "^1.100.0",
        "stylelint": "^16.26.1",
        "stylelint-config-standard-scss": "^14.0.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.61.0",
        "vite": "^7.3.5",
        "vite-plugin-external": "^6.2.2",
        "vitest": "^4.1.8"
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "esbuild",
            "@parcel/watcher"
        ],
        "overrides": {
            "@wordpress/private-apis": "1.48.0",
            "@wordpress/global-styles-engine": "1.15.1"
        }
    },
    "dependencies": {
        "@wordpress/interactivity": "6.48.0",
        "prismjs": "^1.30.0",
        "react-simple-code-editor": "^0.14.1"
    }
}
