		{"value": "everest BASE camp-trek", "format": "case", "arg": "", "opts": {"case": "title"}, "out": "Everest Base Camp-Trek"},
		{"value": "Lighting", "format": "case", "arg": "", "opts": {"case": "lower"}, "out": "lighting"},
