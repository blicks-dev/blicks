		{"value": 999, "format": "number", "arg": "", "opts": {"compact": "yes"}, "out": "999"},
		{"value": 200, "format": "currency", "arg": "", "opts": {"currency": "USD", "show": "code"}, "out": "USD 200"},
		{"value": 200, "format": "currency", "arg": "", "opts": {"currency": "usd", "show": "code-after"}, "out": "200 USD"},
		{"value": 200, "format": "currency", "arg": "", "opts": {"currency": "USD", "show": "both"}, "out": "$200 USD"},
		{"value": 200, "format": "currency", "arg": "", "opts": {"show": "code"}, "out": "USD 200"},
		{"value": 200, "format": "currency", "arg": "", "opts": {"currency": "EUR"}, "out": "€200"},
		{"value": 2390, "format": "currency", "arg": "", "opts": {"currency": "NPR"}, "out": "Rs 2,390"},
		{"value": 200, "format": "currency", "arg": "", "opts": {"currency": "XYZ", "show": "both"}, "out": "XYZ 200"},
