{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "blicks/box",
	"title": "Box",
	"category": "blicks",
	"icon": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" width=\"24\" height=\"24\"><path d=\"M6 3H18A3 3 0 0 1 21 6V18A3 3 0 0 1 18 21H6A3 3 0 0 1 3 18V6A3 3 0 0 1 6 3ZM6 5A1 1 0 0 0 5 6V18A1 1 0 0 0 6 19H18A1 1 0 0 0 19 18V6A1 1 0 0 0 18 5ZM7.75 14.5H12.25A1.25 1.25 0 0 1 13.5 15.75V15.75A1.25 1.25 0 0 1 12.25 17H7.75A1.25 1.25 0 0 1 6.5 15.75V15.75A1.25 1.25 0 0 1 7.75 14.5Z\" fill=\"currentColor\"/><path d=\"M8 6.5H16A1.5 1.5 0 0 1 17.5 8V10.5A1.5 1.5 0 0 1 16 12H8A1.5 1.5 0 0 1 6.5 10.5V8A1.5 1.5 0 0 1 8 6.5Z\" fill=\"#002bff\"/></svg>",
	"description": "One box for every surface: a plain wrapper, card, panel, cover, badge, divider or spacer, arranged stacked, side by side, as a grid or in layers.",
	"keywords": [
		"card",
		"panel",
		"cover",
		"badge",
		"divider",
		"spacer",
		"stack",
		"row",
		"grid",
		"layers",
		"container",
		"group"
	],
	"textdomain": "blicks",
	"supports": {
		"html": false,
		"className": false,
		"anchor": true,
		"blicks": {
			"controls": [
				"layout.*",
				"gridChild.*",
				"columns.*",
				"spacing.*",
				"border.*",
				"position.*",
				"colors.*",
				"background.*",
				"typography.*",
				"effects.*",
				"animation.*",
				"decoration.*", "flexChild.*" ],
			"states": [
				"default",
				"group",
				"groupActive",
				"hover",
				"focus",
				"active",
				"play",
				"on",
				"groupOn",
				"reduced"
			]
		}
	},
	"attributes": {
		"uniqueId": {
			"type": "string"
		},
		"blicks": {
			"type": "object",
			"default": {}
		},
		"kind": {
			"type": "string",
			"default": "plain"
		},
		"tag": {
			"type": "string",
			"default": "div"
		},
		"layers": {
			"type": "boolean",
			"default": false
		},
		"text": {
			"type": "string",
			"default": "",
			"bindable": { "selector": ":root", "onlyIf": { "kind": "badge" } }
		},
		"href": {
			"type": "string",
			"default": ""
		},
		"linkTarget": {
			"type": "string",
			"default": ""
		},
		"rel": {
			"type": "string",
			"default": ""
		},
		"linkLabel": {
			"type": "string",
			"default": ""
		}
	},
	"editorScript": "blicks-editor",
	"style": "file:./index.css"
}
