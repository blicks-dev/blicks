{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "blicks/form",
	"title": "Form",
	"category": "blicks",
	"icon": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" width=\"24\" height=\"24\"><path d=\"M6 3H18A3 3 0 0 1 21 6V18A3 3 0 0 1 18 21H6A3 3 0 0 1 3 18V6A3 3 0 0 1 6 3ZM6 5A1 1 0 0 0 5 6V18A1 1 0 0 0 6 19H18A1 1 0 0 0 19 18V6A1 1 0 0 0 18 5ZM8 7H16A1.5 1.5 0 0 1 17.5 8.5V8.5A1.5 1.5 0 0 1 16 10H8A1.5 1.5 0 0 1 6.5 8.5V8.5A1.5 1.5 0 0 1 8 7ZM8 11.5H16A1.5 1.5 0 0 1 17.5 13V13A1.5 1.5 0 0 1 16 14.5H8A1.5 1.5 0 0 1 6.5 13V13A1.5 1.5 0 0 1 8 11.5Z\" fill=\"currentColor\"/><path d=\"M7.75 16H11.25A1.25 1.25 0 0 1 12.5 17.25V17.25A1.25 1.25 0 0 1 11.25 18.5H7.75A1.25 1.25 0 0 1 6.5 17.25V17.25A1.25 1.25 0 0 1 7.75 16Z\" fill=\"#002bff\"/></svg>",
	"description": "A contact or sign-up form built from Field blocks, with entries, email and spam protection.",
	"textdomain": "blicks",
	"supports": {
		"html": false,
		"className": false,
		"align": [ "wide", "full" ],
		"blicks": {
			"controls": [
				"spacing.*", "border.*", "effects.*", "animation.*", "colors.*", "background.*", "typography.*",
				"layout.width", "layout.minWidth", "layout.maxWidth", "layout.height", "layout.minHeight", "layout.maxHeight",
				"layout.gapRow", "layout.gapColumn",
				"flexChild.*", "gridChild.*"
			],
			"states": [ "default", "reduced" ]
		}
	},
	"attributes": {
		"uniqueId": { "type": "string" },
		"blicks":   { "type": "object", "default": {} },
		"template": { "type": "string", "default": "" },
		"name":     { "type": "string", "default": "" },
		"errorColour": { "type": "string", "default": "" },
		"look":     { "type": "string", "default": "filled" },
		"labels":   { "type": "string", "default": "above" },
		"save":     { "type": "boolean", "default": true },
		"email":    { "type": "object", "default": { "on": true, "to": "", "subject": "", "replyTo": true } },
		"after":    { "type": "object", "default": { "kind": "message", "title": "", "message": "", "page": 0, "dialog": "" } },
		"extensions": { "type": "object", "default": {} },
		"marker":   { "type": "string", "default": "optional" },
		"spam":     { "type": "object", "default": { "minSeconds": 3, "challenge": "none", "minScore": 0.5 } }
	},
	"usesContext": [ "postId" ],
	"providesContext": { "blicks/formMarker": "marker" },
	"render": "file:./render.php",
	"editorScript": "blicks-editor",
	"style": "file:./index.css"
}
