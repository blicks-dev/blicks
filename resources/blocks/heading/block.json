{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "blicks/heading",
	"title": "Heading",
	"category": "blicks",
	"icon": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" width=\"24\" height=\"24\"><path d=\"M5.5 4H6.5A1 1 0 0 1 7.5 5V19A1 1 0 0 1 6.5 20H5.5A1 1 0 0 1 4.5 19V5A1 1 0 0 1 5.5 4ZM17.5 4H18.5A1 1 0 0 1 19.5 5V19A1 1 0 0 1 18.5 20H17.5A1 1 0 0 1 16.5 19V5A1 1 0 0 1 17.5 4Z\" fill=\"currentColor\"/><path d=\"M7.5 10.5L16.5 10.5L16.5 13.5L7.5 13.5Z\" fill=\"#002bff\"/></svg>",
	"description": "A semantic h1-h6 heading that inherits the active theme by default.",
	"textdomain": "blicks",
	"supports": {
		"html": false,
		"className": false,
		"anchor": true,
		"blicks": {
			"controls": [ "gridChild.*", "typography.*", "colors.text", "colors.background", "colors.clipText", "spacing.*", "border.*", "effects.*", "animation.*", "layout.width", "layout.minWidth", "layout.maxWidth", "layout.height", "layout.minHeight", "layout.maxHeight", "flexChild.*", "background.*", "layout.overflow", "layout.isolation", "position.*" ],
			"states": [ "default", "group", "groupActive", "hover", "focus", "active", "play", "on", "groupOn", "reduced" ]
		}
	},
	"attributes": {
		"uniqueId": { "type": "string" },
		"blicks":   { "type": "object", "default": {} },
		"level":    { "type": "number", "default": 2 },
		"content":  { "type": "string", "default": "", "bindable": { "selector": ":root" } }
	},
	"editorScript": "blicks-editor",
	"style":        "file:./index.css"
}
