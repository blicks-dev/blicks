{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "blicks/menu-link",
	"title": "Menu link",
	"category": "blicks",
	"icon": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" width=\"24\" height=\"24\"><path d=\"M11.25 5H19.75A1.25 1.25 0 0 1 21 6.25V6.25A1.25 1.25 0 0 1 19.75 7.5H11.25A1.25 1.25 0 0 1 10 6.25V6.25A1.25 1.25 0 0 1 11.25 5ZM11 9H16A1 1 0 0 1 17 10V10A1 1 0 0 1 16 11H11A1 1 0 0 1 10 10V10A1 1 0 0 1 11 9ZM4.25 14H19.75A1.25 1.25 0 0 1 21 15.25V15.25A1.25 1.25 0 0 1 19.75 16.5H4.25A1.25 1.25 0 0 1 3 15.25V15.25A1.25 1.25 0 0 1 4.25 14ZM4 18.5H14A1 1 0 0 1 15 19.5V19.5A1 1 0 0 1 14 20.5H4A1 1 0 0 1 3 19.5V19.5A1 1 0 0 1 4 18.5Z\" fill=\"currentColor\"/><path d=\"M4.5 5H6.5A1.5 1.5 0 0 1 8 6.5V8.5A1.5 1.5 0 0 1 6.5 10H4.5A1.5 1.5 0 0 1 3 8.5V6.5A1.5 1.5 0 0 1 4.5 5Z\" fill=\"#002bff\"/></svg>",
	"description": "A link for menus and link columns: a label with an optional line of description, an icon and a badge.",
	"keywords": [ "menu", "link", "navigation", "mega menu", "footer" ],
	"textdomain": "blicks",
	"supports": {
		"html": false,
		"className": false,
		"blicks": {
			"controls": [
				"spacing.*", "border.*", "effects.*", "colors.*", "background.*", "typography.*",
				"layout.width", "layout.minWidth", "layout.maxWidth", "layout.height", "layout.minHeight", "layout.maxHeight", "layout.gapColumn", "layout.alignItems",
				"flexChild.*", "gridChild.*", "animation.*"
			],
			"states": [ "default", "hover", "focus", "active", "reduced" ]
		}
	},
	"attributes": {
		"uniqueId":    { "type": "string" },
		"blicks":      { "type": "object", "default": {} },
		"label":       { "type": "string", "default": "" },
		"description": { "type": "string", "default": "" },
		"url":         { "type": "string", "default": "" },
		"linkTarget":  { "type": "string", "default": "" },
		"rel":         { "type": "string", "default": "" },
		"icon":        { "type": "string", "default": "" },
		"badge":       { "type": "string", "default": "" }
	},
	"editorScript": "blicks-editor",
	"style":        "file:./index.css"
}
