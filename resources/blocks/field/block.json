{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "blicks/field",
	"title": "Field",
	"category": "blicks",
	"icon": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" width=\"24\" height=\"24\"><path d=\"M4.25 4H9.75A1.25 1.25 0 0 1 11 5.25V5.25A1.25 1.25 0 0 1 9.75 6.5H4.25A1.25 1.25 0 0 1 3 5.25V5.25A1.25 1.25 0 0 1 4.25 4ZM6 9H18A3 3 0 0 1 21 12V17A3 3 0 0 1 18 20H6A3 3 0 0 1 3 17V12A3 3 0 0 1 6 9ZM6 11A1 1 0 0 0 5 12V17A1 1 0 0 0 6 18H18A1 1 0 0 0 19 17V12A1 1 0 0 0 18 11Z\" fill=\"currentColor\"/><path d=\"M7.5 12.5H7.5A1 1 0 0 1 8.5 13.5V15.5A1 1 0 0 1 7.5 16.5H7.5A1 1 0 0 1 6.5 15.5V13.5A1 1 0 0 1 7.5 12.5Z\" fill=\"#002bff\"/></svg>",
	"description": "One question in a Form — its label, control and help as blocks: short or long text, email, phone, number, date, dropdown, choices, consent or hidden.",
	"textdomain": "blicks",
	"ancestor": [ "blicks/form" ],
	"allowedBlocks": [ "blicks/text", "blicks/input", "blicks/icon" ],
	"usesContext": [ "blicks/formMarker" ],
	"providesContext": {
		"blicks/fieldUid": "uniqueId",
		"blicks/fieldType": "type",
		"blicks/fieldName": "name",
		"blicks/fieldLabel": "label",
		"blicks/fieldRequired": "required",
		"blicks/fieldPlaceholder": "placeholder",
		"blicks/fieldOptions": "options",
		"blicks/fieldMultiple": "multiple",
		"blicks/fieldMin": "min",
		"blicks/fieldMax": "max",
		"blicks/fieldStep": "step",
		"blicks/fieldDefault": "defaultValue",
		"blicks/fieldMaxLength": "maxLength",
		"blicks/fieldOptionNotes": "optionNotes",
		"blicks/fieldAppearance": "appearance",
		"blicks/fieldPrefix": "prefix",
		"blicks/fieldSuffix": "suffix"
	},
	"supports": {
		"html": false,
		"className": false,
		"reusable": false,
		"blicks": {
			"controls": [
				"spacing.*", "typography.*", "colors.*", "border.*", "effects.*", "animation.*", "background.*",
				"layout.gapRow", "layout.gapColumn", "layout.alignItems",
				"layout.width", "layout.minWidth", "layout.maxWidth", "layout.height", "layout.minHeight", "layout.maxHeight",
				"flexChild.*"
			],
			"states": [ "default" ]
		}
	},
	"attributes": {
		"uniqueId":     { "type": "string" },
		"blicks":       { "type": "object", "default": {} },
		"type":         { "type": "string", "default": "text" },
		"label":        { "type": "string", "default": "" },
		"name":         { "type": "string", "default": "" },
		"placeholder":  { "type": "string", "default": "" },
		"help":         { "type": "string", "default": "" },
		"required":     { "type": "boolean", "default": false },
		"errorMessage": { "type": "string", "default": "" },
		"width":        { "type": "string", "default": "full" },
		"options":      { "type": "array", "default": [], "items": { "type": "string" } },
		"multiple":     { "type": "boolean", "default": false },
		"min":          { "type": "string", "default": "" },
		"max":          { "type": "string", "default": "" },
		"step":         { "type": "string", "default": "" },
		"defaultValue": { "type": "string", "default": "" },
		"extensions": { "type": "object", "default": {} },
		"maxLength":    { "type": "string", "default": "" },
		"optionNotes":  { "type": "array", "default": [], "items": { "type": "string" } },
		"appearance":   { "type": "string", "default": "" },
		"prefix":       { "type": "string", "default": "" },
		"suffix":       { "type": "string", "default": "" }
	},
	"render": "file:./render.php",
	"editorScript": "blicks-editor",
	"style": "file:./index.css"
}
