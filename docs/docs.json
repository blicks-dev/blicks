{
	"$schema": "https://mintlify.com/docs.json",
	"theme": "mint",
	"name": "Blicks",
	"description": "Atomic blocks for the WordPress block editor, a design system that syncs with theme.json, and generated block references.",
	"colors": {
		"primary": "#002bff",
		"light": "#8fb0ff",
		"dark": "#0022cc"
	},
	"favicon": "/favicon.svg",
	"icons": {
		"library": "lucide"
	},
	"logo": {
		"light": "/logo/light.svg",
		"dark": "/logo/dark.svg",
		"href": "/"
	},
	"fonts": {
		"heading": {
			"family": "Inter",
			"weight": 650
		},
		"body": {
			"family": "Inter",
			"weight": 500
		}
	},
	"appearance": {
		"default": "light",
		"strict": false
	},
	"styling": {
		"eyebrows": "section",
		"codeblocks": "dark"
	},
	"navbar": {
		"primary": {
			"type": "button",
			"label": "Get Blicks",
			"href": "https://wordpress.org/plugins/blicks/"
		},
		"links": [
			{
				"label": "GitHub",
				"href": "https://github.com/blicks-dev/blicks"
			}
		]
	},
	"footer": {
		"socials": {
			"website": "https://blicks.dev",
			"github": "https://github.com/blicks-dev/blicks"
		}
	},
	"banner": {
		"content": "These docs cover Blicks 2.0, a clean break from 1.x. Updating a site with 1.x pages? Read [Upgrading from 1.x](/upgrading) first.",
		"dismissible": true
	},
	"navigation": {
		"tabs": [
			{
				"tab": "Documentation",
				"groups": [
					{
						"group": "Get started",
						"pages": [
							"index",
							"getting-started",
							"upgrading"
						]
					},
					{
						"group": "Guides",
						"pages": [
							"guides/index",
							"guides/build-a-landing-page",
							"guides/responsive-patterns",
							"guides/states-and-interactions",
							"guides/lists-and-steps",
							"guides/forms",
							"guides/data-loop",
							"guides/dialogs",
							"guides/customize-design-system",
							"guides/connect-an-ai-agent",
							"guides/header-studio"
						]
					},
					{
						"group": "Developers",
						"pages": [
							"developers/extension-api",
							"developers/migrating-from-v1",
							"developers/engine-api",
							"developers/studio-api",
							"developers/php-hooks"
						]
					},
					{
						"group": "Help",
						"pages": [
							"faqs",
							"changelog"
						]
					}
				]
			},
			{
				"tab": "Reference",
				"groups": [
					{
						"group": "Design System",
						"pages": [
							"reference/design-system/global-tokens",
							"reference/design-system/type-roles"
						]
					},
					{
						"group": "Blocks",
						"pages": [
							"reference/blocks/index",
							"reference/blocks/box",
							"reference/blocks/button",
							"reference/blocks/buttons",
							"reference/blocks/dialog",
							"reference/blocks/field",
							"reference/blocks/form",
							"reference/blocks/heading",
							"reference/blocks/icon",
							"reference/blocks/image",
							"reference/blocks/input",
							"reference/blocks/list",
							"reference/blocks/list-item",
							"reference/blocks/loop",
							"reference/blocks/menu-link",
							"reference/blocks/section",
							"reference/blocks/step",
							"reference/blocks/steps",
							"reference/blocks/text"
						]
					}
				]
			}
		]
	},
	"contextual": {
		"options": [
			"copy",
			"view",
			"chatgpt",
			"claude"
		]
	},
	"redirects": [
		{
			"source": "/reference/blocks/stack",
			"destination": "/reference/blocks/box"
		},
		{
			"source": "/reference/blocks/grid",
			"destination": "/reference/blocks/box"
		},
		{
			"source": "/reference/blocks/spacer",
			"destination": "/reference/blocks/box"
		},
		{
			"source": "/reference/blocks/divider",
			"destination": "/reference/blocks/box"
		}
	]
}
