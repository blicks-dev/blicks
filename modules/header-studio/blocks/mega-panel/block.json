{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "blicks/mega-panel",
	"title": "Mega menu",
	"category": "blicks",
	"icon": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" width=\"24\" height=\"24\"><path d=\"M4 3H20A1 1 0 0 1 21 4V5A1 1 0 0 1 20 6H4A1 1 0 0 1 3 5V4A1 1 0 0 1 4 3ZM5 8H19A2 2 0 0 1 21 10V19A2 2 0 0 1 19 21H5A2 2 0 0 1 3 19V10A2 2 0 0 1 5 8Z\" fill=\"currentColor\"/><path d=\"M6 10H8A1 1 0 0 1 9 11V18A1 1 0 0 1 8 19H6A1 1 0 0 1 5 18V11A1 1 0 0 1 6 10Z\" fill=\"#002bff\"/></svg>",
	"description": "The panel a menu item opens: any layout of links, cards and pictures.",
	"keywords": [
		"mega menu",
		"panel",
		"dropdown"
	],
	"textdomain": "blicks-pro",
	"parent": [
		"blicks/nav-item"
	],
	"supports": {
		"html": false,
		"className": false,
		"blicks": {
			"controls": [
				"layout.width",
				"layout.maxWidth",
				"spacing.padding",
				"colors.background",
				"colors.text",
				"background.image",
				"background.gradient",
				"background.size",
				"background.position",
				"border.radius",
				"border.width",
				"border.style",
				"border.color",
				"effects.boxShadow"
			],
			"states": [
				"default"
			]
		}
	},
	"attributes": {
		"uniqueId": {
			"type": "string"
		},
		"blicks": {
			"type": "object",
			"default": {}
		},
		"openOn": {
			"type": "string",
			"default": "hover"
		},
		"delay": {
			"type": "number",
			"default": 150
		},
		"animation": {
			"type": "string",
			"default": "fade"
		},
		"width": {
			"type": "string",
			"default": "container"
		},
		"closeOnScroll": {
			"type": "boolean",
			"default": false
		}
	},
	"example": {
		"attributes": {
			"openOn": "click",
			"width": "full",
			"animation": "slide",
			"closeOnScroll": true
		},
		"innerBlocks": [
			{
				"name": "blicks/menu-link",
				"attributes": {
					"label": "Analytics",
					"description": "Dashboards and reports",
					"url": "/analytics"
				}
			}
		]
	},
	"editorScript": "blicks-pro-header-studio",
	"style": "blicks-pro-header-studio"
}
