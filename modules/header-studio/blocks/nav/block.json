{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "blicks/nav",
	"title": "Navigation",
	"category": "blicks",
	"icon": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" width=\"24\" height=\"24\"><path d=\"M4.25 6H5.75A1.25 1.25 0 0 1 7 7.25V7.25A1.25 1.25 0 0 1 5.75 8.5H4.25A1.25 1.25 0 0 1 3 7.25V7.25A1.25 1.25 0 0 1 4.25 6ZM10.25 6H11.75A1.25 1.25 0 0 1 13 7.25V7.25A1.25 1.25 0 0 1 11.75 8.5H10.25A1.25 1.25 0 0 1 9 7.25V7.25A1.25 1.25 0 0 1 10.25 6ZM16.25 6H19.75A1.25 1.25 0 0 1 21 7.25V7.25A1.25 1.25 0 0 1 19.75 8.5H16.25A1.25 1.25 0 0 1 15 7.25V7.25A1.25 1.25 0 0 1 16.25 6Z\" fill=\"currentColor\"/><path d=\"M4.5 12H19.5A1.5 1.5 0 0 1 21 13.5V16.5A1.5 1.5 0 0 1 19.5 18H4.5A1.5 1.5 0 0 1 3 16.5V13.5A1.5 1.5 0 0 1 4.5 12Z\" fill=\"#002bff\"/></svg>",
	"description": "The header menu: menu items that are links or open a mega menu. On phones it becomes a drawer.",
	"keywords": [
		"menu",
		"navigation",
		"nav"
	],
	"textdomain": "blicks-pro",
	"ancestor": [
		"blicks/header"
	],
	"supports": {
		"html": false,
		"className": false,
		"blicks": {
			"controls": [
				"layout.gapColumn",
				"flexChild.order",
				"typography.fontFamily",
				"typography.fontSize",
				"typography.fontWeight",
				"typography.letterSpacing",
				"typography.textTransform"
			],
			"states": [
				"default"
			]
		}
	},
	"attributes": {
		"uniqueId": {
			"type": "string"
		},
		"blicks": {
			"type": "object",
			"default": {}
		},
		"label": {
			"type": "string",
			"default": "Main"
		},
		"menuLabel": {
			"type": "string",
			"default": "Menu"
		},
		"closeLabel": {
			"type": "string",
			"default": "Close"
		}
	},
	"example": {
		"attributes": {
			"label": "Primary"
		},
		"innerBlocks": [
			{
				"name": "blicks/nav-item",
				"attributes": {
					"label": "Pricing",
					"url": "/pricing"
				}
			},
			{
				"name": "blicks/nav-item",
				"attributes": {
					"label": "Docs",
					"url": "/docs",
					"linkTarget": "_blank"
				}
			}
		]
	},
	"editorScript": "blicks-pro-header-studio",
	"style": "blicks-pro-header-studio"
}
