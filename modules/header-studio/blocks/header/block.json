{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "blicks/header",
	"title": "Header",
	"category": "blicks",
	"icon": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" width=\"24\" height=\"24\"><path d=\"M4.5 3H19.5A1.5 1.5 0 0 1 21 4.5V6.0A1.5 1.5 0 0 1 19.5 7.5H4.5A1.5 1.5 0 0 1 3 6.0V4.5A1.5 1.5 0 0 1 4.5 3ZM5 10H19A2 2 0 0 1 21 12V19A2 2 0 0 1 19 21H5A2 2 0 0 1 3 19V12A2 2 0 0 1 5 10Z\" fill=\"currentColor\"/><path d=\"M6 4.25H8A1 1 0 0 1 9 5.25V5.25A1 1 0 0 1 8 6.25H6A1 1 0 0 1 5 5.25V5.25A1 1 0 0 1 6 4.25Z\" fill=\"#002bff\"/></svg>",
	"description": "A site header: rows of start, centre and end areas, a menu with mega menus, and a phone drawer.",
	"keywords": [
		"header",
		"navigation",
		"menu",
		"mega menu"
	],
	"textdomain": "blicks-pro",
	"supports": {
		"html": false,
		"className": false,
		"blicks": {
			"controls": [
				"colors.background",
				"colors.text",
				"background.image",
				"background.gradient",
				"background.size",
				"background.position",
				"border.width",
				"border.style",
				"border.color",
				"effects.boxShadow",
				"effects.backdropFilter",
				"typography.fontFamily",
				"typography.fontSize",
				"typography.fontWeight",
				"typography.letterSpacing",
				"typography.textTransform"
			],
			"states": [
				"default"
			]
		}
	},
	"attributes": {
		"uniqueId": {
			"type": "string"
		},
		"blicks": {
			"type": "object",
			"default": {}
		},
		"sticky": {
			"type": "boolean",
			"default": false
		},
		"shrink": {
			"type": "boolean",
			"default": false
		},
		"overHero": {
			"type": "boolean",
			"default": false
		},
		"hideOnScroll": {
			"type": "boolean",
			"default": false
		},
		"mobile": {
			"type": "string",
			"default": "drill"
		},
		"drawerAt": {
			"type": "string",
			"default": "tablet"
		}
	},
	"example": {
		"attributes": {
			"sticky": true
		},
		"innerBlocks": [
			{
				"name": "blicks/header-row",
				"attributes": {
					"preset": "classic"
				},
				"innerBlocks": [
					{
						"name": "blicks/header-area",
						"attributes": {
							"slot": "start"
						},
						"innerBlocks": [
							{
								"name": "blicks/text",
								"attributes": {
									"content": "[Your logo]",
									"tag": "span"
								}
							}
						]
					},
					{
						"name": "blicks/header-area",
						"attributes": {
							"slot": "centre"
						},
						"innerBlocks": [
							{
								"name": "blicks/nav",
								"innerBlocks": [
									{
										"name": "blicks/nav-item",
										"attributes": {
											"label": "Pricing",
											"url": "/pricing"
										}
									}
								]
							}
						]
					},
					{
						"name": "blicks/header-area",
						"attributes": {
							"slot": "end"
						}
					}
				]
			}
		]
	},
	"editorScript": "blicks-pro-header-studio",
	"style": "blicks-pro-header-studio"
}
