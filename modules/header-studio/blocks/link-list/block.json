{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "blicks/link-list",
	"title": "Link list",
	"category": "blicks",
	"icon": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" width=\"24\" height=\"24\"><path d=\"M4 5H5A1 1 0 0 1 6 6V7A1 1 0 0 1 5 8H4A1 1 0 0 1 3 7V6A1 1 0 0 1 4 5ZM4 10.5H5A1 1 0 0 1 6 11.5V12.5A1 1 0 0 1 5 13.5H4A1 1 0 0 1 3 12.5V11.5A1 1 0 0 1 4 10.5ZM4 16H5A1 1 0 0 1 6 17V18A1 1 0 0 1 5 19H4A1 1 0 0 1 3 18V17A1 1 0 0 1 4 16Z\" fill=\"currentColor\"/><path d=\"M9.25 5.25H19.75A1.25 1.25 0 0 1 21 6.5V6.5A1.25 1.25 0 0 1 19.75 7.75H9.25A1.25 1.25 0 0 1 8 6.5V6.5A1.25 1.25 0 0 1 9.25 5.25ZM9.25 10.75H19.75A1.25 1.25 0 0 1 21 12.0V12.0A1.25 1.25 0 0 1 19.75 13.25H9.25A1.25 1.25 0 0 1 8 12.0V12.0A1.25 1.25 0 0 1 9.25 10.75ZM9.25 16.25H15.75A1.25 1.25 0 0 1 17 17.5V17.5A1.25 1.25 0 0 1 15.75 18.75H9.25A1.25 1.25 0 0 1 8 17.5V17.5A1.25 1.25 0 0 1 9.25 16.25Z\" fill=\"#002bff\"/></svg>",
	"description": "Links from a WordPress menu or from chosen pages, kept in step with them.",
	"keywords": [
		"menu",
		"links",
		"pages",
		"wordpress menu"
	],
	"textdomain": "blicks-pro",
	"supports": {
		"html": false,
		"className": false
	},
	"attributes": {
		"uniqueId": {
			"type": "string"
		},
		"source": {
			"type": "string",
			"default": "menu"
		},
		"menu": {
			"type": "string",
			"default": ""
		},
		"pages": {
			"type": "array",
			"default": [],
			"items": {
				"type": "number"
			}
		}
	},
	"example": {
		"attributes": {
			"source": "pages",
			"pages": [
				2
			]
		}
	},
	"editorScript": "blicks-pro-header-studio",
	"style": "blicks-pro-header-studio"
}
