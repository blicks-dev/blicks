{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "jsx": "react-jsx",
        "strict": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "esModuleInterop": true,
        "allowJs": true,
        "noEmit": true,
        "types": ["vite/client", "node"],
        "paths": { "@/*": ["./resources/*"] }
    },
    "include": ["resources"]
}
